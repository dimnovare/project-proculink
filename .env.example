# ── ProcuLink frontend environment variables ─────────────────────────────────
# Copy to .env.local for local dev; set all of these in the Vercel project
# dashboard for production.  Never commit real values.
#
# Local dev defaults
NEXT_PUBLIC_API_BASE_URL=http://localhost:5223
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_MSW=false

# Clerk — publishable key is safe to expose; secret key is server-side only
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Sentry — set to your project DSN (safe to expose in browser bundle).
# The DSN also drives the CSP violation report endpoint (see CSP_MODE below).
NEXT_PUBLIC_SENTRY_DSN=
# Needed at BUILD time for source-map upload. Without it, production stack traces
# stay minified. When set, the Sentry plugin logs its upload to the build output.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Content-Security-Policy enforcement. Read at BUILD time (next.config.ts →
# src/lib/security/csp.ts) — changing it requires a redeploy, not just a restart.
#   unset / anything else  → report-only: the full policy ships as
#                            Content-Security-Policy-Report-Only and violations
#                            are POSTed to Sentry, while a small enforced policy
#                            keeps frame-ancestors / base-uri / object-src.
#   enforce                → the full policy is enforced.
# Flip to "enforce" once the Sentry CSP reports are quiet for a real traffic window.
CSP_MODE=

# Optional external status page URL (e.g. https://status.proculink.eu). When empty, the
# "Status" link in the marketing footer is hidden (no dead link). Set to your real status
# page (e.g. a Better Stack / Instatus page) to show it.
NEXT_PUBLIC_STATUS_URL=

# PostHog product analytics (EU region). Leave KEY empty to disable client-side analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Optional Group L Wave 3 — walkthrough video + book-a-demo CTAs. Leave empty to hide the UI.
# Loom embed URL for the walkthrough. Only used when no self-hosted MP4 is set below.
# Empty ⇒ /watch falls back to the MP4 (if set) or a "coming shortly" email-demo card.
NEXT_PUBLIC_WALKTHROUGH_LOOM_URL=
# Self-hosted walkthrough MP4 (e.g. R2 public URL for marketing/walkthrough.mp4) — takes
# priority over Loom. Production uses https://assets.proculink.eu/marketing/walkthrough.mp4
# (verified live: 200, video/mp4). Empty ⇒ /watch shows the email-demo fallback card, and every
# surface that links to /watch (help center, in-app help slideover) hides its Watch link.
NEXT_PUBLIC_WALKTHROUGH_VIDEO_URL=
# Optional poster still shown before play (1920×1080). Empty ⇒ the <video> shows its first frame.
NEXT_PUBLIC_WALKTHROUGH_VIDEO_POSTER=
# Optional scheduling URL for "Book a demo" CTAs (e.g. Cal.com / Calendly). When empty, /watch
# degrades to a mailto:hello@proculink.eu fallback (no dead link, no unmet duration promise) and
# the in-app Pilot "Book a demo" chip is hidden. Set to your real scheduling link to enable it.
NEXT_PUBLIC_BOOK_DEMO_URL=

# Annual billing toggle kill switch (default ON). Annual checkout is live end-to-end (the FE
# sends billingInterval=yearly → the backend maps the plan's Stripe *YearlyPriceId). Set to
# "false" ONLY to hide the Monthly/Annual toggle if annual is ever paused; any other value
# (or unset) leaves annual ON.
NEXT_PUBLIC_ANNUAL_BILLING_ENABLED=
