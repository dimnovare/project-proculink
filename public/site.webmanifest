{
  "id": "/",
  "name": "ProcuLink",
  "short_name": "ProcuLink",
  "description": "ProcuLink reads the invoices, orders and other documents you receive, shows you what it read beside the original, and sends the data on in the format your system needs.",
  "lang": "en",
  "start_url": "/documents",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0B1A2F",
  "theme_color": "#0B1A2F",
  "icons": [
    { "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            ".pdf", ".csv", ".xlsx", ".png", ".jpg", ".jpeg", ".docx", ".txt", ".xml", ".cxml", ".json", ".edi", ".x12",
            "application/pdf", "image/jpeg", "image/png", "text/csv",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/plain", "application/xml", "text/xml", "application/json"
          ]
        }
      ]
    }
  }
}
